# Canonical application URL for Open Graph, JSON-LD, robots, and sitemap.
# Optional locally (falls back to http://localhost:3000). Set in production, or
# Vercel’s VERCEL_URL is used automatically when this is empty.
NEXT_PUBLIC_APP_URL=

# Optional application display name (document title uses this plus SITE_DESCRIPTION).
NEXT_PUBLIC_APP_NAME=forge.dev

# Optional build-time flag if bundle analysis is enabled later.
ANALYZE=
